Options -Indexes

RewriteEngine On

# Never expose application, configuration, or database source directories.
RewriteRule ^(?:app|config|database)(?:/|$) - [F,L]

# Do not rewrite requests that already target the public directory.
RewriteRule ^public(?:/|$) - [L]

# Send the site root and public URLs to the public web root.
RewriteRule ^$ public/index.php [L]
RewriteRule ^(.+)$ public/$1 [L]
